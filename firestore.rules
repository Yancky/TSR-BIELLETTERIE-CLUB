rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'yameogojp2@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'phone', 'role']) &&
             data.keys().hasOnly(['uid', 'fullName', 'phone', 'email', 'role', 'createdAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.phone is string && data.phone.size() <= 25 &&
             data.role in ['TRAVELER', 'COMPANY_AGENT', 'ADMIN'];
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'userId', 'passengerName', 'departureCity', 'arrivalCity', 'seatNumber', 'amountPaid', 'paymentStatus']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.passengerName is string && data.passengerName.size() <= 100 &&
             data.departureCity is string && data.departureCity.size() <= 60 &&
             data.arrivalCity is string && data.arrivalCity.size() <= 60 &&
             data.seatNumber is number &&
             data.amountPaid is number &&
             data.paymentStatus in ['PENDING', 'CONFIRMED', 'CANCELLED'];
    }

    function isValidTrip(data) {
      return data.keys().hasAll(['id', 'departureCity', 'arrivalCity', 'departureTime', 'price', 'availableSeats', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.departureCity is string && data.departureCity.size() <= 60 &&
             data.arrivalCity is string && data.arrivalCity.size() <= 60 &&
             data.price is number &&
             data.availableSeats is number &&
             data.status in ['SCHEDULED', 'BOARDING', 'DEPARTED', 'CANCELLED'];
    }

    function isValidParcel(data) {
      return data.keys().hasAll(['trackingCode', 'senderName', 'recipientName', 'originCity', 'destinationCity', 'feeFcfa', 'status']) &&
             data.trackingCode is string && data.trackingCode.size() <= 40 &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.recipientName is string && data.recipientName.size() <= 100 &&
             data.originCity is string && data.originCity.size() <= 60 &&
             data.destinationCity is string && data.destinationCity.size() <= 60 &&
             data.feeFcfa is number &&
             data.status in ['REGISTERED', 'IN_TRANSIT', 'ARRIVED', 'DELIVERED'];
    }

    function isValidClaim(data) {
      return data.keys().hasAll(['id', 'userId', 'claimType', 'description', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.claimType in ['LOST_LUGGAGE', 'DELAY', 'REFUND', 'SERVICE', 'OTHER'] &&
             data.description is string && data.description.size() <= 1000 &&
             data.status in ['OPEN', 'IN_REVIEW', 'RESOLVED'];
    }

    // 1. User Profiles: Anti-Privilege Escalation Rules
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // On registration, non-admins can ONLY register as TRAVELER
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid &&
                    (isAdmin() || incoming().role == 'TRAVELER');
      // On update, users CANNOT change their own role (must preserve existing().role)
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid &&
                    (isAdmin() || incoming().role == existing().role);
      allow delete: if isAdmin();
    }

    // 2. Electronic Ticket Bookings: Anti-Tamper & Payment Verification
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Client can only create PENDING bookings; CONFIRMED status must be verified by backend/admin
      allow create: if isSignedIn() && isValidBooking(incoming()) && incoming().userId == request.auth.uid &&
                    (isAdmin() || incoming().paymentStatus == 'PENDING');
      // Non-admins can only cancel their booking, not elevate to CONFIRMED
      allow update: if isSignedIn() && isValidBooking(incoming()) && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().userId == existing().userId &&
         incoming().paymentStatus == existing().paymentStatus)
      );
      allow delete: if isAdmin();
    }

    // 3. Bus Trips & Routes: Publicly readable, writeable ONLY by Admins
    match /trips/{tripId} {
      allow read: if true;
      allow create: if isAdmin() && isValidTrip(incoming());
      allow update: if isAdmin() && isValidTrip(incoming());
      allow delete: if isAdmin();
    }

    // 4. Partner Companies & Multi-Company Isolation
    match /companies/{companyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 5. Agencies & Station Desks: Publicly readable, writeable ONLY by Admins
    match /agencies/{agencyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 6. Parcels & Freight
    match /parcels/{parcelId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidParcel(incoming());
      allow update: if isAdmin() && isValidParcel(incoming());
      allow delete: if isAdmin();
    }

    // 7. Customer Claims & Lost/Found
    match /claims/{claimId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidClaim(incoming()) && incoming().userId == request.auth.uid;
      allow update: if (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid)) && isValidClaim(incoming());
      allow delete: if isAdmin();
    }

    // 8. Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
